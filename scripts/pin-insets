#!/usr/bin/env python3
"""Open a PR pinning one validated tile/inset pair; never reset a newer pin.

Uses gh's credential helper rather than embedding credentials in clone URLs.
"""
import argparse
import json
from pathlib import Path
import re
import subprocess
import tempfile


def run(*command, **kwargs):
    return subprocess.run(command, check=True, text=True, **kwargs)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('pin', type=Path)
    parser.add_argument('manifest', type=Path)
    parser.add_argument('--review', action='store_true')
    args = parser.parse_args()
    pin, manifest = json.loads(args.pin.read_text()), json.loads(args.manifest.read_text())
    if manifest['tileVersion'] != pin['version'] or not re.fullmatch('[a-f0-9]{24}', manifest['version']):
        raise ValueError('Inset candidate does not match tiles')
    pin['insets'] = dict(version=manifest['version'], tileVersion=pin['version'])
    branch = "pin/map-assets"
    with tempfile.TemporaryDirectory() as temporary:
        work = Path(temporary)
        run('gh', 'repo', 'clone', 'collisionlab/osrs-planner', str(work), '--', '--depth', '1')
        current = json.loads((work / 'tiles.json').read_text())
        # A late job cannot roll back to an older game cache.
        if int(current['version'].split('-')[0]) > int(pin['version'].split('-')[0]):
            raise ValueError('Candidate predates the planner cache')
        if current['version'] != pin['version']:
            candidate_renderer = pin['version'].split('-', 1)[1]
            current_renderer = current['version'].split('-', 1)[1]
            stale = subprocess.run(['git', 'merge-base', '--is-ancestor', candidate_renderer, current_renderer], cwd=Path(__file__).resolve().parents[1])
            if stale.returncode == 0:
                raise ValueError('Candidate renderer predates the planner tiles')
            newer = subprocess.run(['git', 'merge-base', '--is-ancestor', current_renderer, candidate_renderer], cwd=Path(__file__).resolve().parents[1])
            if newer.returncode != 0:
                raise ValueError('Cannot establish tile renderer ordering')
        if current == pin:
            print('Planner already pins this pair')
            return
        existing = run('gh', 'pr', 'list', '--repo', 'collisionlab/osrs-planner', '--head', branch,
                       '--state', 'open', '--json', 'number', capture_output=True)
        existing_prs = json.loads(existing.stdout)
        remote = run('git', 'ls-remote', 'origin', f'refs/heads/{branch}', cwd=work, capture_output=True).stdout.split()
        previous_head = remote[0] if remote else ''
        run('git', 'switch', '-c', branch, cwd=work)
        (work / 'tiles.json').write_text(json.dumps(pin, indent=2) + '\n')
        run('git', 'add', 'tiles.json', cwd=work)
        run('git', '-c', 'user.name=collisionlab-bot', '-c', 'user.email=collisionlab-bot@users.noreply.github.com',
            'commit', '-m', f"Use inset assets {manifest['version']}", cwd=work)
        if existing_prs and args.review:
            run('gh', 'pr', 'ready', str(existing_prs[0]['number']), '--undo', '--repo', 'collisionlab/osrs-planner', cwd=work)
        run('git', 'push', f'--force-with-lease=refs/heads/{branch}:{previous_head}', 'origin', branch, cwd=work)
        body = work / 'body.md'
        body.write_text(f"Use tiles `{pin['version']}` with inset metadata `{manifest['version']}`.\n\n"
                        f"The build checked cache hashes and required native tile coverage. "
                        f"{manifest['namingReviewCount']} naming issues use fallback labels and do not block publication.\n")
        common = ['--repo', 'collisionlab/osrs-planner', '--title', f"Use inset assets {manifest['version']}", '--body-file', str(body)]
        if existing_prs:
            number = str(existing_prs[0]['number'])
            run('gh', 'pr', 'edit', number, *common, cwd=work)
        else:
            run('gh', 'pr', 'create', '--head', branch, *common,
                *(['--draft'] if args.review else []), cwd=work)


if __name__ == '__main__':
    main()
