#!/usr/bin/env python3
"""Open a PR pinning one validated tile/inset pair; never reset a newer pin.

Consumers that read only the tiles (--tiles-only) get the tile version alone, so their pin moves only
when the tiles do.

The PR is a draft exactly while something needs a person (see review_reasons), and its body says what to
do. When a refresh no longer needs review it is marked ready, so CI merges it. Reachable areas without a
name or an anchor never hold a pin back: the body lists them as follow-ups (see follow_ups).

Uses gh's credential helper rather than embedding credentials in clone URLs.
"""
import argparse
import json
from pathlib import Path
import re
import subprocess
import tempfile
import time


def run(*command, **kwargs):
    # GitHub's API fails now and then ("GraphQL: Something went wrong while executing your query"),
    # after the push has gone through. The gh calls after the clone are idempotent: retry them.
    retries = 3 if command[0] == 'gh' and command[1:3] != ('repo', 'clone') else 1
    for attempt in range(retries):
        try:
            return subprocess.run(command, check=True, text=True, **kwargs)
        except subprocess.CalledProcessError:
            if attempt == retries - 1:
                raise
            time.sleep(15 * (attempt + 1))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('pin', type=Path)
    parser.add_argument('manifest', type=Path)
    parser.add_argument('--tile-review', type=Path, help="scripts/tile-review's output for this candidate")
    parser.add_argument('--geometry-review', action='store_true', help='compare-insets asked for review')
    parser.add_argument('--first-insets', action='store_true', help='the consumer pins no insets yet')
    parser.add_argument('--run-url', default='', help='The workflow run that built the candidate')
    parser.add_argument('--repo', action='append', help='Consumer repository; repeat for multiple consumers')
    parser.add_argument('--tiles-only', action='append', default=[], metavar='REPO',
                        help='Consumer repository that pins only the tiles; repeat for multiple consumers')
    args = parser.parse_args()
    pin, manifest = json.loads(args.pin.read_text()), json.loads(args.manifest.read_text())
    if manifest['tileVersion'] != pin['version'] or not re.fullmatch('[a-f0-9]{24}', manifest['version']):
        raise ValueError('Inset candidate does not match tiles')
    full = dict(pin, insets=dict(version=manifest['version'], tileVersion=pin['version']))
    reasons = review_reasons(args, manifest)
    notes = follow_ups(manifest, Path(args.manifest).parent)
    if not args.repo and not args.tiles_only:
        args.repo, args.tiles_only = ['collisionlab/osrs-planner'], ['collisionlab/osrs-coord-preview']
    for repo in args.repo or []:
        pin_repo(repo, full, manifest, reasons, args.run_url, notes)
    for repo in args.tiles_only:
        pin_repo(repo, pin, None, [reason for reason in reasons if reason[0].startswith('tiles:')], args.run_url)


ANCHORING = {'required-component-unanchored', 'curated-anchor-not-into-component'}
NAMING = {'required-component-unnamed'}


def review_issues(manifest_dir):
    """review.json's issues, each with the coordinate label its component falls back to."""
    review_path, labels_path = manifest_dir / 'review.json', manifest_dir / 'labels.json'
    if not review_path.is_file():
        return []
    regions = json.loads(labels_path.read_text())['regions'] if labels_path.is_file() else {}
    return [dict(issue, fallback=regions.get(issue['componentId'], {}).get('name'))
            for issue in json.loads(review_path.read_text())['issues']]


def listed(issues):
    return ''.join(f"\n  - `{i['componentId']}` ({i['reason']})" + (f": shown as \"{i['fallback']}\"" if i.get('fallback') else '')
                   for i in issues[:20]) + ('\n  - …' if len(issues) > 20 else '')


def review_reasons(args, manifest):
    """Why a person must look before this pin merges, each as (key, title, what to do).

    The key identifies what was checked, so a PR a person marked ready stays ready while nothing new
    turns up (see pin_repo)."""
    pin_version = manifest['tileVersion']
    reasons = []
    if args.first_insets:
        reasons.append(('first', 'This is the first inset bundle.', 'Check the insets in the planner, then mark this PR ready.'))
    tiles = json.loads(args.tile_review.read_text()) if args.tile_review else dict(review=False, styles={})
    if tiles['review']:
        counts = '; '.join(f"{style}: new" if detail.get('new') else
                           f"{style}: {detail['changed']} changed, {detail['added']} added, {detail['removed']} removed "
                           f"of {detail['tiles']}" for style, detail in sorted(tiles['styles'].items()))
        reasons.append((f'tiles:{pin_version}', 'The map tiles changed a lot.',
                        f"More than 10% of a style's tiles differ from the pinned version ({counts}). Look over the "
                        f"map in the planner, then mark this PR ready."))
    if args.geometry_review:
        reasons.append((f'geometry:{pin_version}', 'The inset areas changed a lot.',
                        f"More than 10% of inset areas or covered map squares differ from the pinned bundle "
                        f"(now {manifest['componentCount']} areas). Check the insets in the planner, then mark this "
                        f"PR ready."))
    return reasons


def follow_ups(manifest, manifest_dir):
    """review.json's gaps, each as (title, what to do). They are listed in the PR but don't make it a draft:
    a missing name or anchor shows the coordinate label or the area above the map, which is no worse than
    not publishing the rest of the bundle."""
    if not manifest.get('reviewCount'):
        return []
    issues = review_issues(manifest_dir)
    anchoring = [i for i in issues if i['reason'] in ANCHORING]
    naming = [i for i in issues if i['reason'] in NAMING]
    other = [i for i in issues if i['reason'] not in ANCHORING | NAMING]
    notes = []
    if naming:
        notes.append((f"{len(naming)} reachable areas have no name, so the planner's area search can't find them.",
                      "Name them in osrs-tiles `data/inset-labels/annotations.json` (`scripts/label_inset_regions.py "
                      "--worklist` suggests evidence) and push to `main`; the rebuild opens the next pin."
                      + listed(naming)))
    if anchoring:
        notes.append((f"{len(anchoring)} reachable areas have no anchor, so the planner shows them above the main map.",
                      "Give each an `anchor` in osrs-tiles `data/inset-labels/annotations.json`: a point on the "
                      "surface, or in an area that has an anchor, and a reason (see `docs/tiles.md`)." + listed(anchoring)))
    if other:
        notes.append((f"{len(other)} curated names or cuts no longer match the data.",
                      "Names still follow their seeds; re-point the evidence or component in "
                      "`data/inset-labels/annotations.json` when convenient." + listed(other)))
    return notes


KEYS = re.compile(r'<!-- review-keys: (.*?) -->')


def title(pin, manifest):
    return f"Use inset assets {manifest['version']}" if manifest else f"Use tiles {pin['version']}"


def body(pin, manifest, reasons, run_url, accepted=False, notes=()):
    text = (f"Use tiles `{pin['version']}` with inset metadata `{manifest['version']}`.\n\n"
            "The build checked cache hashes and that the tiles cover every inset area.\n\n" if manifest else
            f"Use tiles `{pin['version']}`.\n\n")
    if accepted:
        text += ("**No action needed.** A person marked this ready after checking it; CI merges it once it "
                 "passes, and the merge releases it. Checked:\n\n"
                 + ''.join(f"- [x] **{title}**\n" for _, title, _ in reasons))
    elif reasons:
        text += ("## Action needed\n\n"
                 "This PR is a **draft** because a person needs to check it; it won't merge by itself until it is "
                 "marked ready. Then CI runs and merges it, and the merge releases it.\n\n"
                 + ''.join(f"- [ ] **{title}** {action}\n" for _, title, action in reasons))
    else:
        text += "**No action needed.** Nothing needs review: CI merges this once it passes, and the merge releases it.\n"
    if notes:
        text += ("\n## Follow-ups\n\nThese don't hold the pin back.\n\n"
                 + ''.join(f"- **{title}** {action}\n" for title, action in notes))
    if run_url:
        text += f"\nBuilt by {run_url}.\n"
    return text + f"\n<!-- review-keys: {' '.join(key for key, _, _ in reasons)} -->\n"


def pin_repo(repo, pin, manifest, reasons, run_url, notes=()):
    branch = "pin/map-assets"
    with tempfile.TemporaryDirectory() as temporary:
        work = Path(temporary)
        run('gh', 'repo', 'clone', repo, str(work), '--', '--depth', '1')
        current = json.loads((work / 'tiles.json').read_text())
        # A late job cannot roll back to an older game cache.
        if int(current['version'].split('-')[0]) > int(pin['version'].split('-')[0]):
            raise ValueError('Candidate predates the consumer cache')
        candidate_renderer = pin['version'].split('-', 1)[1]
        current_renderer = current['version'].split('-', 1)[1]
        if current_renderer != candidate_renderer:
            stale = subprocess.run(['git', 'merge-base', '--is-ancestor', candidate_renderer, current_renderer], cwd=Path(__file__).resolve().parents[1])
            if stale.returncode == 0:
                raise ValueError('Candidate renderer predates the consumer tiles')
            newer = subprocess.run(['git', 'merge-base', '--is-ancestor', current_renderer, candidate_renderer], cwd=Path(__file__).resolve().parents[1])
            if newer.returncode != 0:
                raise ValueError('Cannot establish tile renderer ordering')
        updated = {**current, **pin}
        if manifest is None:
            updated.pop('insets', None)  # Tiles-only consumers read no inset bundle.
        if current == updated:
            print(f'{repo} already pins this pair')
            return
        existing = run('gh', 'pr', 'list', '--repo', repo, '--head', branch,
                       '--state', 'open', '--json', 'number,isDraft,body', capture_output=True)
        existing_prs = json.loads(existing.stdout)
        # Marked ready by a person (the bot only does that with nothing to check) after seeing every
        # reason that still applies: keep it ready.
        seen = KEYS.search(existing_prs[0].get('body') or '') if existing_prs else None
        accepted = bool(reasons and existing_prs and not existing_prs[0].get('isDraft') and seen
                        and {key for key, _, _ in reasons} <= set(seen.group(1).split()))
        draft = bool(reasons) and not accepted
        remote = run('git', 'ls-remote', 'origin', f'refs/heads/{branch}', cwd=work, capture_output=True).stdout.split()
        previous_head = remote[0] if remote else ''
        run('git', 'switch', '-c', branch, cwd=work)
        (work / 'tiles.json').write_text(json.dumps(updated, indent=2) + '\n')
        run('git', 'add', 'tiles.json', cwd=work)
        run('git', '-c', 'user.name=collisionlab-bot', '-c', 'user.email=collisionlab-bot@users.noreply.github.com',
            'commit', '-m', title(pin, manifest), cwd=work)
        # Back to draft before the push, so CI on the new head can't merge it.
        if existing_prs and draft and not existing_prs[0].get('isDraft'):
            run('gh', 'pr', 'ready', str(existing_prs[0]['number']), '--undo', '--repo', repo, cwd=work)
        run('git', 'push', f'--force-with-lease=refs/heads/{branch}:{previous_head}', 'origin', branch, cwd=work)
        body_file = work / 'body.md'
        body_file.write_text(body(pin, manifest, reasons, run_url, accepted, notes))
        common = ['--repo', repo, '--title', title(pin, manifest), '--body-file', str(body_file)]
        if existing_prs:
            number = str(existing_prs[0]['number'])
            run('gh', 'pr', 'edit', number, *common, cwd=work)
            # Nothing left to check: ready_for_review starts the CI run that merges it.
            if not draft and existing_prs[0].get('isDraft'):
                run('gh', 'pr', 'ready', number, '--repo', repo, cwd=work)
        else:
            run('gh', 'pr', 'create', '--head', branch, *common,
                *(['--draft'] if draft else []), cwd=work)


if __name__ == '__main__':
    main()
