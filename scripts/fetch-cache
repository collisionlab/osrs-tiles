#!/usr/bin/env python3
"""Download an OSRS cache and its XTEA keys from archive.openrs2.org.

    scripts/fetch-cache DIR            latest live oldschool cache
    scripts/fetch-cache DIR --id N     a specific openrs2 cache id
    scripts/fetch-cache --latest-id    print the latest id and exit

Writes DIR/cache/ (the disk cache), DIR/keys.json (in the field names
RuneLite's XteaKeyManager reads) and DIR/cache-id. Standard library only.
"""
import argparse
import io
import json
import shutil
import sys
import urllib.request
import zipfile
from pathlib import Path

API = "https://archive.openrs2.org"


def get(url: str) -> bytes:
    with urllib.request.urlopen(url, timeout=300) as r:
        return r.read()


def latest_id() -> int:
    caches = json.loads(get(f"{API}/caches.json"))
    live = [c for c in caches if c.get("game") == "oldschool" and c.get("environment") == "live"]
    if not live:
        sys.exit("no live oldschool caches listed by openrs2")
    return max(live, key=lambda c: c.get("timestamp") or "")["id"]


def main() -> None:
    p = argparse.ArgumentParser()
    p.add_argument("dir", nargs="?", type=Path)
    p.add_argument("--id", type=int)
    p.add_argument("--latest-id", action="store_true")
    a = p.parse_args()

    if a.latest_id:
        print(latest_id())
        return
    if a.dir is None:
        p.error("DIR is required")

    cache_id = a.id or latest_id()
    base = f"{API}/caches/runescape/{cache_id}"
    out = a.dir
    cache = out / "cache"
    if cache.exists():
        shutil.rmtree(cache)
    cache.mkdir(parents=True)

    print(f"openrs2 cache {cache_id}: downloading disk.zip", file=sys.stderr)
    with zipfile.ZipFile(io.BytesIO(get(f"{base}/disk.zip"))) as z:
        for member in z.infolist():
            name = Path(member.filename)
            # The archive holds cache/main_file_cache.*; flatten into DIR/cache.
            if member.is_dir() or name.name.startswith("."):
                continue
            if not name.name.startswith("main_file_cache."):
                continue
            (cache / name.name).write_bytes(z.read(member))
    if not (cache / "main_file_cache.idx255").is_file():
        sys.exit("disk.zip held no main_file_cache.idx255")

    keys = json.loads(get(f"{base}/keys.json"))
    for k in keys:
        if "mapsquare" in k:
            k["region"] = k.pop("mapsquare")
        if "key" in k:
            k["keys"] = k.pop("key")
    (out / "keys.json").write_text(json.dumps(keys, indent=2) + "\n")
    (out / "cache-id").write_text(f"{cache_id}\n")
    print(f"{cache}: {sum(1 for _ in cache.iterdir())} files, {len(keys)} keys", file=sys.stderr)


if __name__ == "__main__":
    main()
