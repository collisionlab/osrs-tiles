#!/usr/bin/env python3
"""Prefer the exact public game-cache keys used for the pinned tile render.

Legacy tile releases have no snapshot; their archive keys are accepted only
when their hash matches the published manifest.
"""
import hashlib
import json
from pathlib import Path
import sys
import urllib.error
import urllib.request

pin = json.loads(Path(sys.argv[1]).read_text())
output = Path(sys.argv[2])
base = f"{pin['base']}/tactical/{pin['version']}"

def get(file):
    request = urllib.request.Request(f'{base}/{file}', headers={'User-Agent': 'collisionlab-insets/1.0'})
    with urllib.request.urlopen(request, timeout=60) as response:
        return response.read()

manifest = json.loads(get('manifest.json'))
try:
    raw = get('xteas.json')
except urllib.error.HTTPError as error:
    if error.code != 404:
        raise
    raw = output.read_bytes()
if hashlib.sha256(raw).hexdigest() != manifest['xteasSha256']:
    raise ValueError('Game-cache keys do not match the pinned render')
output.write_bytes(raw)
