#!/usr/bin/env bash
# Publish a complete candidate, manifest last. Retry partial uploads safely.
set -euo pipefail
candidate=$1
version=$(jq -r .version "$candidate/manifest.json")
[[ "$version" =~ ^[a-f0-9]{24}$ ]] || exit 1
export RCLONE_CONFIG_R2_TYPE=s3
export RCLONE_CONFIG_R2_PROVIDER=Cloudflare
export RCLONE_CONFIG_R2_ENDPOINT=$R2_ENDPOINT
export RCLONE_CONFIG_R2_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID
export RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY
export RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
destination="r2:collisionlab-tiles/insets/$version"
published_manifest=$(mktemp)
trap 'rm -f "$published_manifest"' EXIT
if rclone cat "$destination/manifest.json" > "$published_manifest" 2>/dev/null; then
  cmp "$candidate/manifest.json" "$published_manifest"
  echo "Already published $version"
  exit 0
fi
immutable="Cache-Control: public, max-age=31536000, immutable"
rclone copy "$candidate" "$destination" --exclude manifest.json --header-upload "$immutable" --transfers 16
# Check remote bytes before publishing the completion marker.
rclone check "$candidate" "$destination" --exclude manifest.json --download --one-way
rclone copyto "$candidate/manifest.json" "$destination/manifest.json" --header-upload "$immutable"
