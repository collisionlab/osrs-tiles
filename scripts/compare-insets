#!/usr/bin/env python3
"""Print whether terrain changes need review. Naming uncertainty never blocks."""
import json
from pathlib import Path
import sys
import urllib.request


def needs_review(candidate, previous):
    old_squares = {(plane, square) for plane, squares in enumerate(previous['planes']) for square in squares}
    new_squares = {(plane, square) for plane, squares in enumerate(candidate['planes']) for square in squares}
    count = previous['componentCount']
    return (len(old_squares ^ new_squares) > .10 * max(len(old_squares), 1)
            or abs(candidate['componentCount'] - count) > .10 * max(count, 1))


def main():
    candidate, pin = (json.loads(Path(p).read_text()) for p in sys.argv[1:])
    previous = pin.get('insets')
    review = True
    if previous:
        url = f"{pin['base']}/insets/{previous['version']}/manifest.json"
        with urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': 'collisionlab-insets/1.0'}), timeout=60) as response:
            review = needs_review(candidate, json.load(response))
    print(str(review).lower())


if __name__ == '__main__':
    main()
