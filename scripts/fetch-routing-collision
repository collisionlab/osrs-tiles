#!/usr/bin/env python3
"""Download a pinned tile release's collision files, checking the index checksums."""
import concurrent.futures
import hashlib
import json
import re
import subprocess
import sys
from pathlib import Path

base, version, output = sys.argv[1:]
if not re.fullmatch(r'\d+-[a-f0-9]{12}', version):
    raise SystemExit('invalid tile version')
root = Path(output)
root.mkdir(parents=True, exist_ok=True)

def fetch(name):
    target = root / name
    target.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(['curl', '--fail', '--silent', '--show-error', '--location', '--retry', '2',
                    f'{base}/collision/{version}/{name}', '--output', str(target)], check=True)
    return target.read_bytes()

fetch('manifest.json')
index = json.loads(fetch('index.json'))
def plane(entry):
    name, digest = entry
    if not re.fullmatch(r'(p[1-3]/)?8/\d+/\d+\.bin', name):
        raise ValueError('invalid collision path')
    if hashlib.sha256(fetch(name)).hexdigest() != digest:
        raise ValueError(f'collision checksum mismatch: {name}')
with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
    list(pool.map(plane, index.items()))
