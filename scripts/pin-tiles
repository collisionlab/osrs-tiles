#!/usr/bin/env bash
# Opens a PR in collisionlab/osrs-planner pinning a tiles version. osrs-planner
# merges collisionlab-bot's pin/* PRs itself once its checks pass. A version
# that needs a look (many changed tiles) opens as a draft, which is never
# merged automatically; marking it ready merges it after the checks.
#
#   scripts/pin-tiles VERSION STYLES REVIEW SUMMARY-FILE   (GH_TOKEN: collisionlab-bot, osrs-planner)
#
# STYLES is comma-separated; REVIEW is true or false.
set -euo pipefail

version=$1
styles=$2
review=$3
summary=$4
branch="pin/tiles-$version"
work=$(mktemp -d)

git clone -q --depth 1 "https://x-access-token:${GH_TOKEN}@github.com/collisionlab/osrs-planner.git" "$work"
jq -n --arg version "$version" --arg styles "$styles" \
  '{base: "https://tiles.collisionlab.world", version: $version, styles: ($styles | split(","))}' > "$work/tiles.json"
cd "$work"
git switch -q -c "$branch"
git add tiles.json
git -c user.name="collisionlab-bot" -c user.email="collisionlab-bot@users.noreply.github.com" \
  commit -qm "Use tiles $version"
git push -q origin "$branch"
draft=()
[ "$review" = true ] && draft=(--draft)
gh pr create --repo collisionlab/osrs-planner --head "$branch" "${draft[@]}" --title "Use tiles $version" \
  --body-file - <<BODY
Tiles \`$version\` from collisionlab/osrs-tiles ($styles), published at
https://tiles.collisionlab.world/<style>/$version/.

$(cat "$summary")
BODY
